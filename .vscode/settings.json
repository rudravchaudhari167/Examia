{
  "java.project.sourcePaths": [
    "backend/src"
  ],
  "java.project.outputPath": "backend/bin",
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.jdt.ls.java.home": "/Library/Java/JavaVirtualMachines/jdk-26.jdk/Contents/Home",
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-21",
      "path": "/Library/Java/JavaVirtualMachines/jdk-26.jdk/Contents/Home",
      "default": true
    }
  ],
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/node_modules": true,
    "backend/bin": true,
    "backend/data": true,
    "frontend/dist": true,
    ".classpath": true,
    ".project": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "backend/bin": true,
    "backend/data": true,
    "frontend/dist": true
  }
}
